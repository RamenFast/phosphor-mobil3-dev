<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="dev.phosphor.mobil3.fortress.permission.NEXUS_BINDER"
        android:label="Phosphor Fortress Nexus Binder"
        android:protectionLevel="signature" />

    <application android:label="@string/app_name">
        <provider
            android:name="dev.phosphor.mobil3.nexus.admin.Pm3AdminProvider"
            android:authorities="${applicationId}.pm3"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name="dev.phosphor.mobil3.nexus.binder.NexusBinderService"
            android:exported="true"
            android:permission="dev.phosphor.mobil3.fortress.permission.NEXUS_BINDER">
            <intent-filter>
                <action android:name="dev.phosphor.mobil3.fortress.NEXUS_BINDER" />
            </intent-filter>
        </service>
    </application>
</manifest>
