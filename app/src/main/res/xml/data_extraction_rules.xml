<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />

        <!-- Remote endpoints and runtime consent belong to one device and network. -->
        <exclude domain="sharedpref" path="remote_hosts.xml" />
        <exclude domain="sharedpref" path="phosphor.runtime.xml" />

        <!-- Retired private containers stay excluded if an older install left them behind. -->
        <exclude domain="sharedpref" path="entitlement.xml" />
        <exclude domain="sharedpref" path="phosphor.causal_state.xml" />
        <exclude domain="sharedpref" path="phosphor.pm3.tailnet.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="." />

        <!-- A new device must establish its own endpoints, consent, and runtime state. -->
        <exclude domain="sharedpref" path="remote_hosts.xml" />
        <exclude domain="sharedpref" path="phosphor.runtime.xml" />

        <!-- Retired private containers never transfer to another device. -->
        <exclude domain="sharedpref" path="entitlement.xml" />
        <exclude domain="sharedpref" path="phosphor.causal_state.xml" />
        <exclude domain="sharedpref" path="phosphor.pm3.tailnet.xml" />
    </device-transfer>
</data-extraction-rules>
