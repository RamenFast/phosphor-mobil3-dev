#!/usr/bin/env bash
# pm3 - agent-first development CLI for phosphor-mobil3.
set -uo pipefail

TOOL="pm3"
VERSION="0.2.0"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERIAL="${PM3_SERIAL:-}"
DISTRIBUTION="fortress"
PROFILE="debug"
PHASE05_FIX="Activate Phase 05 by wiring dev/pm3 to the authenticated Nexus Binder/tailnet client, then retry this exact verb."
USAGE_TEXT="pm3 [--json] [--serial SERIAL] [--distribution play|fortress] [--profile debug|release] <verb> [args]"

# shellcheck disable=SC1091
[ -f "$REPO/scripts/env.sh" ] && source "$REPO/scripts/env.sh"

usage() {
  cat <<EOF
pm3 $VERSION - phosphor-mobil3 development CLI
usage: pm3 [--json] [--serial SERIAL] [--distribution play|fortress] [--profile debug|release] <verb> [args]
verbs: help, schema, doctor, pair, connect, build, install, run, logcat, screenshot, record,
       media, fps, smoke, state-get, state-watch, nexus-status, nexus-grant, nexus-revoke,
       action-run, audit-list, audit-export
EOF
}

now() { date +%Y-%m-%dT%H:%M:%S%:z; }

json_escape() {
  local input="$1" output="" char code
  LC_ALL=C
  while [ -n "$input" ]; do
    char="${input:0:1}"
    input="${input:1}"
    case "$char" in
      '"') output+='\"' ;;
      \\) output+="\\\\" ;;
      $'\b') output+='\b' ;;
      $'\f') output+='\f' ;;
      $'\n') output+='\n' ;;
      $'\r') output+='\r' ;;
      $'\t') output+='\t' ;;
      *)
        printf -v code '%d' "'$char"
        if [ "$code" -lt 32 ]; then
          printf -v char '\\u%04x' "$code"
        fi
        output+="$char"
        ;;
    esac
  done
  printf '%s' "$output"
}

succeed() {
  local data="${1:-}"
  printf '{"status":"ok","tool":"%s","version":"%s","ts":"%s","data":{%s}}\n' \
    "$TOOL" "$VERSION" "$(now)" "$data"
  exit 0
}

fail() {
  local code="$1" error="$2" message="$3" fix="$4" data="${5:-}"
  if [ "$code" -eq 3 ]; then
    data="\"usage\":\"$(json_escape "$USAGE_TEXT")\"${data:+,$data}"
  fi
  printf '{"status":"error","tool":"%s","version":"%s","ts":"%s","error":"%s","message":"%s","fix":"%s","data":{%s}}\n' \
    "$TOOL" "$VERSION" "$(now)" "$(json_escape "$error")" "$(json_escape "$message")" \
    "$(json_escape "$fix")" "$data"
  exit "$code"
}

stream_event() {
  local event="$1" extra="${2:-}"
  printf '{"status":"ok","tool":"%s","version":"%s","ts":"%s","event":"%s"%s}\n' \
    "$TOOL" "$VERSION" "$(now)" "$(json_escape "$event")" "${extra:+,$extra}"
}

stream_fail() {
  local error="$1" message="$2" fix="$3"
  printf '{"status":"error","tool":"%s","version":"%s","ts":"%s","event":"stream_error","error":"%s","message":"%s","fix":"%s"}\n' \
    "$TOOL" "$VERSION" "$(now)" "$(json_escape "$error")" "$(json_escape "$message")" "$(json_escape "$fix")"
  exit 4
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || fail 2 dependency_unavailable "$1 not on PATH" "$2"
}

validate_distribution() {
  case "$DISTRIBUTION" in
    play|fortress) ;;
    *) fail 3 invalid_distribution "invalid distribution: $DISTRIBUTION" "use --distribution play or --distribution fortress" ;;
  esac
}

validate_profile() {
  case "$PROFILE" in
    debug|release) ;;
    *) fail 3 invalid_profile "invalid profile: $PROFILE" "use --profile debug or --profile release" ;;
  esac
}

capitalize() {
  printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]'
  printf '%s' "${1:1}"
}

package_id() {
  if [ "$DISTRIBUTION" = play ]; then printf '%s\n' 'dev.phosphor.mobil3'; else printf '%s\n' 'dev.phosphor.mobil3.fortress'; fi
}

gradle_task() { printf 'assemble%s%s\n' "$(capitalize "$DISTRIBUTION")" "$(capitalize "$PROFILE")"; }
apk_path() { printf '%s/app/build/outputs/apk/%s/%s/app-%s-%s.apk\n' "$REPO" "$DISTRIBUTION" "$PROFILE" "$DISTRIBUTION" "$PROFILE"; }

selected_adb() { printf '%s\n' "${PM3_ADB:-adb}"; }
selected_keytool() { printf '%s\n' "${PM3_KEYTOOL:-keytool}"; }
selected_gradle() {
  if [ -n "${PM3_GRADLE:-}" ]; then
    printf '%s\n' "$PM3_GRADLE"
  elif [ -x "$REPO/gradlew" ]; then
    printf '%s\n' "$REPO/gradlew"
  else
    printf '%s\n' gradle
  fi
}

need_serial() {
  [ -n "$SERIAL" ] || fail 3 serial_required "explicit device serial required" "pass --serial SERIAL or set PM3_SERIAL; pm3 never chooses the first adb device"
  ADB_CMD="$(selected_adb)"
  need_command "$ADB_CMD" "install Android platform tools and ensure adb is on PATH"
}

adb_s() {
  need_serial
  "$ADB_CMD" -s "$SERIAL" "$@"
}

parse_globals() {
  local request_help=0 request_schema=0
  ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --serial)
        [ "$#" -ge 2 ] || fail 3 missing_argument "--serial requires a value" "use --serial SERIAL"
        SERIAL="$2"; shift 2 ;;
      --serial=*) SERIAL="${1#--serial=}"; shift ;;
      --distribution)
        [ "$#" -ge 2 ] || fail 3 missing_argument "--distribution requires a value" "use --distribution play or --distribution fortress"
        DISTRIBUTION="$2"; shift 2 ;;
      --distribution=*) DISTRIBUTION="${1#--distribution=}"; shift ;;
      --profile)
        [ "$#" -ge 2 ] || fail 3 missing_argument "--profile requires a value" "use --profile debug or --profile release"
        PROFILE="$2"; shift 2 ;;
      --profile=*) PROFILE="${1#--profile=}"; shift ;;
      --release) PROFILE="release"; shift ;;
      --debug) PROFILE="debug"; shift ;;
      --help|-h) request_help=1; shift ;;
      --schema) request_schema=1; shift ;;
      --*) fail 3 unknown_argument "unknown global argument: $1" "run pm3 help or pm3 schema" ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
  if [ "$request_schema" -eq 1 ]; then
    VERB=schema
    REST=("${ARGS[@]}")
  elif [ "$request_help" -eq 1 ]; then
    VERB=help
    REST=("${ARGS[@]}")
  else
    VERB="${ARGS[0]:-help}"
    REST=("${ARGS[@]:1}")
  fi
  validate_distribution
  validate_profile
}

no_args() {
  [ "$#" -eq 0 ] || fail 3 unexpected_argument "unexpected argument for $VERB: $1" "run pm3 schema for exact arguments"
}

