    "installEnvelope":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","data"],"properties":{"status":{"const":"ok"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"data":{"$ref":"#/$defs/installData"}}},
    "runEnvelope":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","data"],"properties":{"status":{"const":"ok"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"data":{"$ref":"#/$defs/runData"}}},
    "screenshotEnvelope":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","data"],"properties":{"status":{"const":"ok"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"data":{"$ref":"#/$defs/screenshotData"}}},
    "recordEnvelope":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","data"],"properties":{"status":{"const":"ok"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"data":{"$ref":"#/$defs/recordData"}}},
    "mediaEnvelope":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","data"],"properties":{"status":{"const":"ok"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"data":{"$ref":"#/$defs/mediaData"}}},
