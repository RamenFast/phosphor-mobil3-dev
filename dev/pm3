    "logcatEvent":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","event","serial","package_id","line"],"properties":{"status":{"const":"ok"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"event":{"const":"logcat"},"serial":{"type":"string","minLength":1},"package_id":{"type":"string"},"line":{"type":"string"}}},
    "streamError":{"type":"object","additionalProperties":false,"required":["status","tool","version","ts","event","error","message","fix"],"properties":{"status":{"const":"error"},"tool":{"const":"pm3"},"version":{"const":"0.2.0"},"ts":{"$ref":"#/$defs/timestamp"},"event":{"const":"stream_error"},"error":{"const":"logcat_failed"},"message":{"type":"string","minLength":1},"fix":{"type":"string","minLength":1}}},
    "phase05Verb":{"type":"object","additionalProperties":false,"required":["arguments","mode","availability","errors","exits"],"properties":{"arguments":{"const":[]},"mode":{"const":"one-shot"},"availability":{"const":"Phase 05a exit 2 and side-effect free until authenticated transport activation"},"errors":{"oneOf":[{"$ref":"#/$defs/errorEnvelopeUsage"},{"$ref":"#/$defs/errorEnvelopeEmpty"}]},"exits":{"const":[2,3]}}}
