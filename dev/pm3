release_signing_preflight() {
  [ "$PROFILE" = release ] || return 0
  local prefix name value expected actual export_error export_cert missing=()
  if [ "$DISTRIBUTION" = play ]; then prefix=PLAY_UPLOAD; else prefix=RELEASE; fi
  for name in STORE_FILE STORE_PASSWORD KEY_ALIAS KEY_PASSWORD; do
    name="${prefix}_${name}"
    value="${!name:-}"
    [ -n "$value" ] || missing+=("$name")
  done
  if [ "$DISTRIBUTION" = play ] && [ -z "${PLAY_UPLOAD_CERT_SHA256:-}" ]; then
    missing+=(PLAY_UPLOAD_CERT_SHA256)
  fi
  if [ "${#missing[@]}" -gt 0 ]; then
    fail 2 signing_inputs_missing \
      "$DISTRIBUTION release signing unavailable: missing $(IFS=,; printf '%s' "${missing[*]}")" \
      "provide every required ${prefix}_* signing input outside the repository, then rerun pm3 --distribution $DISTRIBUTION --profile release build"
  fi
  local store_name="${prefix}_STORE_FILE"
  local alias_name="${prefix}_KEY_ALIAS"
  local pass_name="${prefix}_STORE_PASSWORD"
  local store_file="${!store_name}"
  local key_alias="${!alias_name}"
  [ -f "$store_file" ] || fail 2 signing_keystore_missing \
    "$DISTRIBUTION release signing unavailable: keystore not found" "correct $store_name and retry"
  local keytool_cmd
  keytool_cmd="$(selected_keytool)"
  need_command "$keytool_cmd" "install a JDK containing keytool to verify the release signer"
  export_error="${TMPDIR:-/tmp}/pm3-keytool-$$.err"
  export_cert="${TMPDIR:-/tmp}/pm3-keytool-$$.der"
  if ! "$keytool_cmd" -exportcert -alias "$key_alias" -keystore "$store_file" \
      -storepass:env "$pass_name" >"$export_cert" 2>"$export_error" || [ ! -s "$export_cert" ]; then
    local detail
    detail="$(tail -3 "$export_error" 2>/dev/null | tr '\n' ' ')"
    rm -f "$export_error" "$export_cert"
    fail 2 signing_verification_failed \
      "$DISTRIBUTION release signing unavailable: keystore or alias verification failed: $detail" \
      "verify $store_name, $alias_name, ${prefix}_STORE_PASSWORD, and keystore format"
  fi
  actual="$(sha256sum "$export_cert" | cut -d' ' -f1)"
  rm -f "$export_error" "$export_cert"
  if [ "$DISTRIBUTION" = play ]; then
    expected="${PLAY_UPLOAD_CERT_SHA256//:/}"
  else
    expected="e4d14ce2d62983acd393f012cbce759b6c97bdcca979feeb04a97afb279d9b00"
  fi
  expected="${expected,,}"
  [ "$actual" = "$expected" ] || fail 2 signing_certificate_mismatch \
    "$DISTRIBUTION release signing unavailable: certificate mismatch" \
    "use the ratified signer whose SHA-256 is $expected"
  return 0
}

phase05_unavailable() {
  no_args "$@"
  fail 2 phase_unavailable \
    "Phase 05 protocol verb $VERB unavailable: no authenticated Binder/tailnet client is wired" "$PHASE05_FIX"
}

parse_globals "$@"
set -- "${REST[@]}"

case "$VERB" in
  help)
    no_args "$@"
    succeed '"usage":"pm3 [--json] [--serial SERIAL] [--distribution play|fortress] [--profile debug|release] <verb> [args]","verbs":["doctor","pair","connect","build","install","run","logcat","screenshot","record","media","fps","smoke","schema","state-get","state-watch","nexus-status","nexus-grant","nexus-revoke","action-run","audit-list","audit-export"]'
    ;;
  schema)
    no_args "$@"
    schema
    ;;
  doctor)
    no_args "$@"
    checks=""
    all_ok=true
    add_check() {
      checks="${checks:+$checks,}{\"check\":\"$(json_escape "$1")\",\"ok\":$2,\"detail\":\"$(json_escape "$3")\"}"
      [ "$2" = true ] || all_ok=false
    }
    adb_cmd="$(selected_adb)"
    if command -v "$adb_cmd" >/dev/null 2>&1; then
      if adb_version="$($adb_cmd --version 2>&1)"; then
        add_check adb true "$(printf '%s\n' "$adb_version" | head -1)"
      else
        add_check adb false "adb --version failed: $(printf '%s' "$adb_version" | tail -1)"
      fi
    else
      add_check adb false "missing $adb_cmd"
    fi
    gradle_cmd="$(selected_gradle)"
    if command -v "$gradle_cmd" >/dev/null 2>&1; then
      add_check gradle true "$gradle_cmd"
    else
      add_check gradle false "missing $gradle_cmd"
    fi
    if command -v cargo >/dev/null 2>&1; then
      add_check cargo true "$(cargo --version 2>/dev/null)"
    else
      add_check cargo false "missing cargo"
    fi
    doctor_data="\"all_ok\":$all_ok,\"distribution\":\"$DISTRIBUTION\",\"profile\":\"$PROFILE\",\"package_id\":\"$(package_id)\",\"gradle_task\":\"$(gradle_task)\",\"apk\":\"$(json_escape "$(apk_path)")\",\"checks\":[$checks]"
    if [ "$all_ok" = true ]; then
      succeed "$doctor_data" "pm3 doctor: all prerequisites ready; distribution=$DISTRIBUTION profile=$PROFILE package=$(package_id)"
    else
      fail 2 prerequisites_unavailable "pm3 prerequisites are unavailable" \
        "install or repair every failed doctor check, then retry" "$doctor_data"
    fi
    ;;
  pair)
    need_command "$(selected_adb)" "install Android platform tools and ensure adb is on PATH"
    [ "$#" -eq 2 ] || fail 3 pair_usage "usage: pm3 pair <ip:port> <code>" \
      "get both values from Wireless debugging > Pair device with pairing code"
    output="$("$(selected_adb)" pair "$1" "$2" 2>&1)" || fail 4 pair_failed \
      "pairing failed: $output" "re-open the pairing dialog because codes expire, then retry"
    printf '%s' "$output" | grep -qi 'successfully paired' || fail 4 pair_failed \
      "pairing failed: $output" "re-open the pairing dialog because codes expire, then retry"
    succeed "\"paired\":\"$(json_escape "$1")\",\"detail\":\"$(json_escape "$output")\"" "paired $1"
    ;;
  connect)
    need_command "$(selected_adb)" "install Android platform tools and ensure adb is on PATH"
    [ "$#" -eq 1 ] || fail 3 connect_usage "usage: pm3 connect <ip:port>" \
      "pass the current Wireless debugging connect address explicitly"
    output="$("$(selected_adb)" connect "$1" 2>&1)" || fail 4 connect_failed \
      "connect failed: $output" "check phone and PC share a network; wireless debugging ports change"
    printf '%s' "$output" | grep -Eqi '(^| )(connected to|already connected to) ' || fail 4 connect_failed \
      "connect failed: $output" "check the explicit address and current Wireless debugging port, then retry"
    succeed "\"target\":\"$(json_escape "$1")\",\"detail\":\"$(json_escape "$output")\"" "connected to $1"
    ;;
  build)
    no_args "$@"
    release_signing_preflight
    task="$(gradle_task)"
    log_file="$REPO/app/build/reports/pm3/build-$DISTRIBUTION-$PROFILE.log"
    mkdir -p "$(dirname "$log_file")"
    gradle_cmd="$(selected_gradle)"
    need_command "$gradle_cmd" "install Gradle or restore ./gradlew"
    if ! (cd "$REPO" && "$gradle_cmd" "$task") >"$log_file" 2>&1; then
      fail 4 build_failed "gradle $task failed: $(tail -3 "$log_file" 2>/dev/null | tr '\n' ' ')" \
        "read $log_file"
    fi
    apk="$(apk_path)"
    [ -f "$apk" ] || fail 4 apk_missing "build succeeded but APK missing at $apk" \
      "check Android Gradle output naming for $DISTRIBUTION/$PROFILE"
    succeed "\"distribution\":\"$DISTRIBUTION\",\"profile\":\"$PROFILE\",\"package_id\":\"$(package_id)\",\"gradle_task\":\"$task\",\"apk\":\"$(json_escape "$apk")\",\"bytes\":$(stat -c%s "$apk"),\"sha256\":\"$(sha256sum "$apk" | cut -d' ' -f1)\"" "built $apk"
    ;;
  install)
    no_args "$@"
    need_serial
    apk="$(apk_path)"
    [ -f "$apk" ] || fail 2 apk_unavailable "APK not built: $apk" \
      "run pm3 --distribution $DISTRIBUTION --profile $PROFILE build first"
    output="$(adb_s install -r "$apk" 2>&1)" || fail 4 install_failed \
      "install failed: $output" "check device storage, signing lineage, and install prompts"
    output="${output//$'\r'/}"
    [ "$output" = Success ] || fail 4 install_failed "install failed: $output" \
      "check package signing lineage, device storage, and install prompts"
    if ! package_dump="$(adb_s shell dumpsys package "$(package_id)" 2>&1)"; then
      fail 4 package_query_failed "installed package query failed: $package_dump" \
        "verify the explicit serial remains connected and authorized"
    fi
    installed_version="$(printf '%s\n' "$package_dump" | grep -m1 versionName | sed 's/.*versionName=//' | tr -d '\r ')"
    [ -n "$installed_version" ] || fail 4 version_missing "installed package has no versionName" \
      "verify the expected package was installed"
    succeed "\"serial\":\"$(json_escape "$SERIAL")\",\"package_id\":\"$(package_id)\",\"installed_version\":\"$(json_escape "${installed_version:-unknown}")\"" "installed $(package_id) on $SERIAL"
    ;;
  run)
    no_args "$@"
    need_serial
    package="$(package_id)"
    adb_s shell am start -n "$package/.MainActivity" >/dev/null 2>&1 || fail 4 launch_failed \
      "am start failed" "run pm3 install first"
    if ! pid_output="$(adb_s shell pidof "$package" 2>&1)"; then
      fail 4 pid_query_failed "pid query failed: $pid_output" \
        "verify the explicit serial remains connected and authorized"
    fi
    pids="$(printf '%s' "$pid_output" | tr -d '\r' | xargs)"
    [ -n "$pids" ] || fail 4 process_missing "app did not stay up" "run pm3 --serial $SERIAL logcat"
    succeed "\"serial\":\"$(json_escape "$SERIAL")\",\"package_id\":\"$package\",\"pids\":\"$(json_escape "$pids")\"" "started $package on $SERIAL (pids $pids)"
    ;;
  logcat)
    no_args "$@"
    need_serial
    package="$(package_id)"
    printf 'pm3 logcat: streaming adb logcat as NDJSON\n' >&2
    "$ADB_CMD" -s "$SERIAL" logcat -v time -s phosphor-mobil3:V AndroidRuntime:E DEBUG:F \
      2> >(sed 's/^/adb: /' >&2) |
      while IFS= read -r line; do
        stream_event logcat "\"serial\":\"$(json_escape "$SERIAL")\",\"package_id\":\"$package\",\"line\":\"$(json_escape "$line")\""
      done
    logcat_rc="${PIPESTATUS[0]}"
    [ "$logcat_rc" -eq 0 ] || stream_fail logcat_failed "adb logcat exited $logcat_rc" \
      "verify the explicit serial remains connected and authorized, then retry"
    ;;
  screenshot)
    [ "$#" -le 1 ] || fail 3 screenshot_usage "usage: pm3 screenshot [out.png]" \
      "provide zero or one output path"
    need_serial
    output_path="${1:-$REPO/docs/dev/receipts/screen-$(date +%Y%m%d-%H%M%S).png}"
    mkdir -p "$(dirname "$output_path")"
    tmp_output="$(dirname "$output_path")/.pm3-$(basename "$output_path").$$.tmp"
    if ! "$ADB_CMD" -s "$SERIAL" exec-out screencap -p >"$tmp_output" 2>/dev/null || [ ! -s "$tmp_output" ]; then
      rm -f "$tmp_output"
      fail 4 screenshot_capture_failed "screencap produced no image" \
        "ensure the explicit device is connected, on, and unlocked"
    fi
    mv -f "$tmp_output" "$output_path" || { rm -f "$tmp_output"; fail 4 screenshot_save_failed \
      "screencap save failed" "verify the output directory is writable, then retry"; }
    succeed "\"png\":\"$(json_escape "$output_path")\",\"bytes\":$(stat -c%s "$output_path")" "saved $output_path"
    ;;
  record)
    [ "$#" -le 2 ] || fail 3 record_usage "usage: pm3 record [seconds] [out.mp4]" \
      "provide a numeric duration and optional output path"
    seconds="${1:-10}"
    case "$seconds" in *[!0-9]*|'') fail 3 invalid_duration "record seconds must be numeric" "use pm3 record 10" ;; esac
    if [ "$seconds" -lt 1 ] || [ "$seconds" -gt 180 ]; then
      fail 3 invalid_duration "record seconds must be from 1 through 180" "use pm3 record 10"
    fi
    need_serial
    output_path="${2:-$REPO/docs/dev/receipts/record-$(date +%Y%m%d-%H%M%S).mp4}"
    mkdir -p "$(dirname "$output_path")"
    tmp_output="$(dirname "$output_path")/.pm3-$(basename "$output_path").$$.tmp"
    if ! screenrecord_detail="$(adb_s shell screenrecord --time-limit "$seconds" /sdcard/pm3-rec.mp4 2>&1)"; then
      adb_s shell rm /sdcard/pm3-rec.mp4 >/dev/null 2>&1 || true
      fail 4 record_capture_failed "screenrecord failed: $screenrecord_detail" \
        "ensure the screen is on and device storage is available"
    fi
    if ! adb_s pull /sdcard/pm3-rec.mp4 "$tmp_output" >/dev/null || [ ! -s "$tmp_output" ]; then
      rm -f "$tmp_output"
      adb_s shell rm /sdcard/pm3-rec.mp4 >/dev/null 2>&1 || true
      fail 4 record_pull_failed "screenrecord pull failed" \
        "verify device storage and the explicit serial, then retry"
    fi
    if ! adb_s shell rm /sdcard/pm3-rec.mp4 >/dev/null; then
      rm -f "$tmp_output"
      fail 4 record_cleanup_failed "record pulled but device cleanup failed" \
        "remove /sdcard/pm3-rec.mp4 from the explicit device, then retry; the requested local output was not replaced"
    fi
    mv -f "$tmp_output" "$output_path" || { rm -f "$tmp_output"; fail 4 record_save_failed \
      "record save failed" "verify the output directory is writable, then retry"; }
    succeed "\"mp4\":\"$(json_escape "$output_path")\",\"bytes\":$(stat -c%s "$output_path"),\"seconds\":$seconds" "saved $output_path"
    ;;
  media)
    no_args "$@"
    need_serial
    package="$(package_id)"
    if ! media_dump="$(adb_s shell dumpsys media_session 2>&1)"; then
      fail 4 media_query_failed "media-session query failed: $media_dump" \
        "verify the explicit serial remains connected and authorized"
    fi
    if ! audio_dump="$(adb_s shell dumpsys audio 2>&1)"; then
      fail 4 audio_query_failed "audio query failed: $audio_dump" \
        "verify the explicit serial remains connected and authorized"
    fi
    media_session="$(printf '%s\n' "$media_dump" | grep -iA6 "$package" | head -20 || true)"
    audio="$(printf '%s\n' "$audio_dump" | grep -i "$package" | head -10 || true)"
    succeed "\"media_session\":\"$(json_escape "${media_session:-none}")\",\"audio\":\"$(json_escape "${audio:-none}")\"" "media_session=${media_session:-none}; audio=${audio:-none}"
    ;;
  fps)
    no_args "$@"
    need_serial
    if ! gfx_dump="$(adb_s shell dumpsys gfxinfo "$(package_id)" 2>&1)"; then
      fail 4 gfxinfo_query_failed "gfxinfo query failed: $gfx_dump" \
        "verify the explicit serial remains connected and authorized"
    fi
    gfx="$(printf '%s\n' "$gfx_dump" | grep -E 'Total frames|Janky|percentile' | head -8 || true)"
    [ -n "$gfx" ] || fail 2 gfxinfo_unavailable "no gfxinfo for $(package_id)" \
      "run pm3 run first and render a visible frame"
    succeed "\"gfxinfo\":\"$(json_escape "$gfx")\"" "$gfx"
    ;;
  smoke)
    no_args "$@"
    need_serial
    package="$(package_id)"
    if ! package_dump="$(adb_s shell pm dump "$package" 2>&1)"; then
      fail 4 package_query_failed "installed package query failed: $package_dump" \
        "verify the explicit serial remains connected and authorized"
    fi
    printf '%s\n' "$package_dump" | grep -q 'pkgFlags.*DEBUGGABLE' || fail 2 debuggable_required \
      "installed build is not debuggable" "run pm3 --profile debug build and pm3 --profile debug install"
    adb_s shell am broadcast -a "$package.SELFTEST" -n "$package/.SelfTestReceiver" >/dev/null 2>&1 || \
      fail 4 broadcast_failed "broadcast failed" "install a current debug build"
    report=""
    for _ in $(seq 1 20); do
      sleep 0.5
      report="$(adb_s shell run-as "$package" cat files/selftest.json 2>/dev/null)"
      [ -n "$report" ] && break
    done
    [ -n "$report" ] || fail 4 selftest_timeout "selftest.json never appeared" \
      "run pm3 --serial $SERIAL logcat"
    output_path="$REPO/docs/dev/receipts/selftest-$(date +%Y%m%d-%H%M%S).png"
    mkdir -p "$(dirname "$output_path")"
    if ! "$ADB_CMD" -s "$SERIAL" shell run-as "$package" cat files/selftest.png >"$output_path" 2>/dev/null || [ ! -s "$output_path" ]; then
      rm -f "$output_path"
      fail 4 selftest_image_failed "selftest image pull failed" \
        "inspect pm3 logcat on the explicit device"
    fi
    succeed "\"report_json\":\"$(json_escape "$report")\",\"png_pulled\":\"$(json_escape "$output_path")\"" "selftest passed; image=$output_path"
    ;;
  state-get|state-watch|nexus-status|nexus-grant|nexus-revoke|action-run|audit-list|audit-export)
    phase05_unavailable "$@"
    ;;
  *) fail 3 unknown_verb "unknown verb: $VERB" "run pm3 help or pm3 schema" ;;
esac
