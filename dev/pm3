#!/usr/bin/env bash
# pm3: agent-first local development CLI for phosphor-mobil3.
set -uo pipefail

TOOL="pm3"
VERSION="1.0.0"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RECEIPTS_DIR="${PM3_RECEIPTS_DIR:-$REPO/docs/dev/receipts}"
SERIAL="${PM3_SERIAL:-}"
PROFILE="debug"
JSON_FORCE=0
USAGE_TEXT="pm3 [--json] [--serial SERIAL] [--profile debug|release] <verb> [args]"

# shellcheck disable=SC1091
[ -f "$REPO/scripts/env.sh" ] && source "$REPO/scripts/env.sh"

now() { date +%Y-%m-%dT%H:%M:%S%:z; }
want_json() { [ "$JSON_FORCE" -eq 1 ] || [ ! -t 1 ]; }

json_escape() {
  local input="$1" output="" char code
  LC_ALL=C
  while [ -n "$input" ]; do
    char="${input:0:1}"
    input="${input:1}"
    case "$char" in
      '"') output+='\"' ;;
      \\) output+="\\\\" ;;
      $'\b') output+='\b' ;;
      $'\f') output+='\f' ;;
      $'\n') output+='\n' ;;
      $'\r') output+='\r' ;;
      $'\t') output+='\t' ;;
      *)
        printf -v code '%d' "'$char"
        if [ "$code" -lt 32 ]; then printf -v char '\\u%04x' "$code"; fi
        output+="$char"
        ;;
    esac
  done
  printf '%s' "$output"
}

succeed() {
  local data="${1:-}" human="${2:-ok}"
  if want_json; then
    printf '{"status":"ok","tool":"%s","version":"%s","ts":"%s","data":{%s}}\n' \
      "$TOOL" "$VERSION" "$(now)" "$data"
  else
    printf '%s\n' "$human"
  fi
  exit 0
}

fail() {
  local code="$1" error="$2" message="$3" fix="$4" data="${5:-}"
  if [ "$code" -eq 3 ]; then
    data="\"usage\":\"$(json_escape "$USAGE_TEXT")\"${data:+,$data}"
  fi
  if want_json; then
    printf '{"status":"error","tool":"%s","version":"%s","ts":"%s","error":"%s","message":"%s","fix":"%s","data":{%s}}\n' \
      "$TOOL" "$VERSION" "$(now)" "$(json_escape "$error")" "$(json_escape "$message")" \
      "$(json_escape "$fix")" "$data"
  else
    printf 'error: %s\nmessage: %s\nfix: %s\n' "$error" "$message" "$fix" >&2
  fi
  exit "$code"
}

stream_event() {
  local event="$1" extra="${2:-}"
  printf '{"status":"ok","tool":"%s","version":"%s","ts":"%s","event":"%s"%s}\n' \
    "$TOOL" "$VERSION" "$(now)" "$(json_escape "$event")" "${extra:+,$extra}"
}

stream_fail() {
  local error="$1" message="$2" fix="$3"
  printf '{"status":"error","tool":"%s","version":"%s","ts":"%s","event":"stream_error","error":"%s","message":"%s","fix":"%s"}\n' \
    "$TOOL" "$VERSION" "$(now)" "$(json_escape "$error")" "$(json_escape "$message")" "$(json_escape "$fix")"
  exit 4
}

usage() {
  cat <<EOF
pm3 $VERSION - phosphor-mobil3 development CLI
usage: $USAGE_TEXT
verbs: help, schema, doctor, pair, connect, build, install, run, logcat,
       screenshot, record, media, fps, smoke
EOF
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || fail 2 dependency_unavailable "$1 not on PATH" "$2"
}

validate_profile() {
  case "$PROFILE" in
    debug|release) ;;
    *) fail 3 invalid_profile "invalid profile: $PROFILE" "use --profile debug or --profile release" ;;
  esac
}

capitalize() {
  printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]'
  printf '%s' "${1:1}"
}

package_id() {
  if [ "$PROFILE" = debug ]; then
    printf '%s\n' 'dev.phosphor.mobil3.debug'
  else
    printf '%s\n' 'dev.phosphor.mobil3'
  fi
}

gradle_task() { printf 'assemble%s\n' "$(capitalize "$PROFILE")"; }
apk_path() { printf '%s/app/build/outputs/apk/%s/app-%s.apk\n' "$REPO" "$PROFILE" "$PROFILE"; }
selected_adb() { printf '%s\n' "${PM3_ADB:-adb}"; }
selected_keytool() { printf '%s\n' "${PM3_KEYTOOL:-keytool}"; }
selected_apksigner() {
  printf '%s\n' "${PM3_APKSIGNER:-${ANDROID_HOME:-$REPO/.toolchain/Sdk}/build-tools/36.0.0/apksigner}"
}
selected_gradle() {
  if [ -n "${PM3_GRADLE:-}" ]; then
    printf '%s\n' "$PM3_GRADLE"
  elif [ -x "$REPO/gradlew" ]; then
    printf '%s\n' "$REPO/gradlew"
  else
    printf '%s\n' gradle
  fi
}

need_serial() {
  [ -n "$SERIAL" ] || fail 3 serial_required \
    "explicit device serial required" \
    "pass --serial SERIAL or set PM3_SERIAL; pm3 never selects the first adb device"
  ADB_CMD="$(selected_adb)"
  need_command "$ADB_CMD" "install Android platform tools and ensure adb is on PATH"
}

adb_s() {
  need_serial
  "$ADB_CMD" -s "$SERIAL" "$@"
}

parse_globals() {
  local request_help=0 request_schema=0
  ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) JSON_FORCE=1; shift ;;
      --serial)
        [ "$#" -ge 2 ] || fail 3 missing_argument "--serial requires a value" "use --serial SERIAL"
        SERIAL="$2"; shift 2 ;;
      --serial=*) SERIAL="${1#--serial=}"; shift ;;
      --profile)
        [ "$#" -ge 2 ] || fail 3 missing_argument "--profile requires a value" "use --profile debug or --profile release"
        PROFILE="$2"; shift 2 ;;
      --profile=*) PROFILE="${1#--profile=}"; shift ;;
      --release) PROFILE="release"; shift ;;
      --debug) PROFILE="debug"; shift ;;
      --help|-h) request_help=1; shift ;;
      --schema) request_schema=1; shift ;;
      --*) fail 3 unknown_argument "unknown global argument: $1" "run pm3 help or pm3 schema" ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
  if [ "$request_schema" -eq 1 ]; then
    VERB=schema
    REST=("${ARGS[@]}")
  elif [ "$request_help" -eq 1 ]; then
    VERB=help
    REST=("${ARGS[@]}")
  else
    VERB="${ARGS[0]:-help}"
    REST=("${ARGS[@]:1}")
  fi
  validate_profile
}

no_args() {
  [ "$#" -eq 0 ] || fail 3 unexpected_argument \
    "unexpected argument for $VERB: $1" "run pm3 schema for exact arguments"
}

schema() {
  local contract
  contract="$(cat <<'JSON' | tr -d '\n'
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phosphor.dev/schemas/pm3-cli-1.0.0.json",
  "title":"pm3 developer CLI contract",
  "description":"Machine-readable contract for the local Phosphor Mobile build and explicit-device workflow. It exposes no product control surface.",
  "type":"object",
  "additionalProperties":false,
  "required":["rendering","globals","defaults","device_selection","mappings","signing","capabilities","verbs","streams","exit_codes"],
  "properties":{
    "rendering":{"const":{"tty":"human text for one-shots","pipe":"one JSON object for one-shots","schema":"always JSON","streams":"NDJSON with a canonical event field"}},
    "globals":{"const":["--json","--serial SERIAL","--profile debug|release","--debug","--release","--help","--schema","PM3_SERIAL","PM3_ADB","PM3_GRADLE","PM3_KEYTOOL","PM3_APKSIGNER"]},
    "defaults":{"const":{"profile":"debug"}},
    "device_selection":{"const":{"rule":"every device operation requires an explicit serial","accepted_sources":["--serial SERIAL","PM3_SERIAL"]}},
    "mappings":{"const":{"debug":{"package_id":"dev.phosphor.mobil3.debug","task":"assembleDebug","apk":"app/build/outputs/apk/debug/app-debug.apk"},"release":{"package_id":"dev.phosphor.mobil3","task":"assembleRelease","apk":"app/build/outputs/apk/release/app-release.apk"}}},
    "signing":{"const":{"profile_selector":"PHOSPHOR_SIGNING_PROFILE=production|play-upload","production_prefix":"RELEASE","play_upload_prefix":"PLAY_UPLOAD","required_suffixes":["STORE_FILE","STORE_PASSWORD","KEY_ALIAS","KEY_PASSWORD","CERT_SHA256"],"verification":"the selected certificate SHA-256 must exactly match before a release build"}},
    "capabilities":{"const":{"local":["help","schema","doctor","pair","connect","build"],"device":["install","run","logcat","screenshot","record","media","fps","smoke"]}},
    "verbs":{"type":"object","additionalProperties":false,"required":["help","schema","doctor","pair","connect","build","install","run","logcat","screenshot","record","media","fps","smoke"],"properties":{
      "help":{"const":{"command":"pm3 help","mode":"one-shot","exits":[0,3]}},
      "schema":{"const":{"command":"pm3 schema","aliases":["pm3 --schema"],"mode":"always-json one-shot","exits":[0,3]}},
      "doctor":{"const":{"command":"pm3 doctor","mode":"one-shot","exits":[0,2,3]}},
      "pair":{"const":{"command":"pm3 pair <ip:port> <code>","mode":"one-shot","exits":[0,2,3,4]}},
      "connect":{"const":{"command":"pm3 connect <ip:port>","mode":"one-shot","exits":[0,2,3,4]}},
      "build":{"const":{"command":"pm3 [--profile debug|release] build","mode":"one-shot","exits":[0,2,3,4]}},
      "install":{"const":{"command":"pm3 --serial SERIAL install [APK]","device_required":true,"mode":"one-shot","default_apk":"profile Gradle output","exits":[0,2,3,4]}},
      "run":{"const":{"command":"pm3 --serial SERIAL run","device_required":true,"mode":"one-shot","exits":[0,2,3,4]}},
      "logcat":{"const":{"command":"pm3 --serial SERIAL logcat","device_required":true,"mode":"NDJSON stream","exits":[0,2,3,4]}},
      "screenshot":{"const":{"command":"pm3 --serial SERIAL screenshot [out.png]","device_required":true,"format":"PNG","exits":[0,2,3,4]}},
      "record":{"const":{"command":"pm3 --serial SERIAL record [seconds] [out.mp4]","device_required":true,"format":"MP4","exits":[0,2,3,4]}},
      "media":{"const":{"command":"pm3 --serial SERIAL media","device_required":true,"mode":"one-shot","exits":[0,2,3,4]}},
      "fps":{"const":{"command":"pm3 --serial SERIAL fps","device_required":true,"mode":"one-shot","exits":[0,2,3,4]}},
      "smoke":{"const":{"command":"pm3 --serial SERIAL smoke","device_required":true,"debug_required":true,"mode":"one-shot","exits":[0,2,3,4]}}
    }},
    "streams":{"const":{"logcat":{"event":"logcat","terminal_error_event":"stream_error"}}},
    "exit_codes":{"const":{"0":"success","2":"dependency or capability unavailable","3":"bad input or usage","4":"runtime failure"}}
  }
}
JSON
)"
  printf '{"status":"ok","tool":"%s","version":"%s","ts":"%s","data":{"schema":%s}}\n' \
    "$TOOL" "$VERSION" "$(now)" "$contract"
  exit 0
}

release_signing_preflight() {
  [ "$PROFILE" = release ] || return 0
  local signing_profile prefix name value store_name alias_name pass_name store_file key_alias
  local keytool_cmd export_error export_cert actual expected detail
  local missing=()
  signing_profile="${PHOSPHOR_SIGNING_PROFILE:-production}"
  case "$signing_profile" in
    production) prefix=RELEASE ;;
    play-upload) prefix=PLAY_UPLOAD ;;
    *) fail 3 invalid_signing_profile \
      "invalid PHOSPHOR_SIGNING_PROFILE: $signing_profile" \
      "use production or play-upload" ;;
  esac
  for name in STORE_FILE STORE_PASSWORD KEY_ALIAS KEY_PASSWORD CERT_SHA256; do
    value="${prefix}_${name}"
    [ -n "${!value:-}" ] || missing+=("$value")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    fail 2 signing_inputs_missing \
      "$prefix release signing unavailable: missing $(IFS=,; printf '%s' "${missing[*]}")" \
      "provide every required ${prefix}_* input outside the repository"
  fi
  store_name="${prefix}_STORE_FILE"
  alias_name="${prefix}_KEY_ALIAS"
  pass_name="${prefix}_STORE_PASSWORD"
  store_file="${!store_name}"
  key_alias="${!alias_name}"
  [ -f "$store_file" ] || fail 2 signing_keystore_missing \
    "$prefix release signing unavailable: keystore not found" "correct $store_name and retry"
  keytool_cmd="$(selected_keytool)"
  need_command "$keytool_cmd" "install a JDK containing keytool"
  export_error="${JCODE_SCRATCH_DIR:-${TMPDIR:-/tmp}}/pm3-keytool-$$.err"
  export_cert="${JCODE_SCRATCH_DIR:-${TMPDIR:-/tmp}}/pm3-keytool-$$.der"
  if ! "$keytool_cmd" -exportcert -alias "$key_alias" -keystore "$store_file" \
      -storepass:env "$pass_name" >"$export_cert" 2>"$export_error" || [ ! -s "$export_cert" ]; then
    detail="$(tail -3 "$export_error" 2>/dev/null | tr '\n' ' ')"
    rm -f "$export_error" "$export_cert"
    fail 2 signing_verification_failed \
      "$prefix release signing unavailable: certificate export failed: $detail" \
      "verify the selected keystore, alias, password, and format"
  fi
  actual="$(sha256sum "$export_cert" | cut -d' ' -f1)"
  rm -f "$export_error" "$export_cert"
  name="${prefix}_CERT_SHA256"
  expected="${!name//:/}"
  expected="${expected,,}"
  [ "$actual" = "$expected" ] || fail 2 signing_certificate_mismatch \
    "$prefix release signing certificate mismatch" \
    "use the approved signer whose SHA-256 is $expected"
}

parse_globals "$@"
set -- "${REST[@]}"

case "$VERB" in
  help)
    no_args "$@"
    if want_json; then
      succeed '"usage":"pm3 [--json] [--serial SERIAL] [--profile debug|release] <verb> [args]","verbs":["help","schema","doctor","pair","connect","build","install","run","logcat","screenshot","record","media","fps","smoke"]'
    else
      usage
      exit 0
    fi
    ;;
  schema)
    no_args "$@"
    schema
    ;;
  doctor)
    no_args "$@"
    checks=""
    all_ok=true
    add_check() {
      checks="${checks:+$checks,}{\"check\":\"$(json_escape "$1")\",\"ok\":$2,\"detail\":\"$(json_escape "$3")\"}"
      [ "$2" = true ] || all_ok=false
    }
    adb_cmd="$(selected_adb)"
    if command -v "$adb_cmd" >/dev/null 2>&1 && adb_version="$($adb_cmd --version 2>&1)"; then
      add_check adb true "$(printf '%s\n' "$adb_version" | head -1)"
    else
      add_check adb false "missing or broken $adb_cmd"
    fi
    gradle_cmd="$(selected_gradle)"
    if command -v "$gradle_cmd" >/dev/null 2>&1; then add_check gradle true "$gradle_cmd"; else add_check gradle false "missing $gradle_cmd"; fi
    if command -v cargo >/dev/null 2>&1; then add_check cargo true "$(cargo --version 2>/dev/null)"; else add_check cargo false "missing cargo"; fi
    doctor_data="\"all_ok\":$all_ok,\"profile\":\"$PROFILE\",\"package_id\":\"$(package_id)\",\"gradle_task\":\"$(gradle_task)\",\"apk\":\"$(json_escape "$(apk_path)")\",\"checks\":[$checks]"
    if [ "$all_ok" = true ]; then
      succeed "$doctor_data" "pm3 doctor: prerequisites ready; profile=$PROFILE package=$(package_id)"
    else
      fail 2 prerequisites_unavailable "pm3 prerequisites are unavailable" \
        "install or repair every failed doctor check" "$doctor_data"
    fi
    ;;
  pair)
    need_command "$(selected_adb)" "install Android platform tools and ensure adb is on PATH"
    [ "$#" -eq 2 ] || fail 3 pair_usage "usage: pm3 pair <ip:port> <code>" \
      "get both values from Wireless debugging > Pair device with pairing code"
    output="$("$(selected_adb)" pair "$1" "$2" 2>&1)" || fail 4 pair_failed \
      "pairing failed: $output" "re-open the pairing dialog because codes expire"
    printf '%s' "$output" | grep -qi 'successfully paired' || fail 4 pair_failed \
      "pairing failed: $output" "re-open the pairing dialog because codes expire"
    succeed "\"paired\":\"$(json_escape "$1")\",\"detail\":\"$(json_escape "$output")\"" "paired $1"
    ;;
  connect)
    need_command "$(selected_adb)" "install Android platform tools and ensure adb is on PATH"
    [ "$#" -eq 1 ] || fail 3 connect_usage "usage: pm3 connect <ip:port>" \
      "pass the current Wireless debugging connect address explicitly"
    output="$("$(selected_adb)" connect "$1" 2>&1)" || fail 4 connect_failed \
      "connect failed: $output" "check the explicit address and current Wireless debugging port"
    printf '%s' "$output" | grep -Eqi '(^| )(connected to|already connected to) ' || fail 4 connect_failed \
      "connect failed: $output" "check the explicit address and current Wireless debugging port"
    succeed "\"target\":\"$(json_escape "$1")\",\"detail\":\"$(json_escape "$output")\"" "connected to $1"
    ;;
  build)
    no_args "$@"
    release_signing_preflight
    task="$(gradle_task)"
    log_file="$REPO/app/build/reports/pm3/build-$PROFILE.log"
    mkdir -p "$(dirname "$log_file")"
    gradle_cmd="$(selected_gradle)"
    need_command "$gradle_cmd" "install Gradle or restore ./gradlew"
    if ! (cd "$REPO" && "$gradle_cmd" "$task") >"$log_file" 2>&1; then
      fail 4 build_failed "gradle $task failed: $(tail -3 "$log_file" 2>/dev/null | tr '\n' ' ')" "read $log_file"
    fi
    apk="$(apk_path)"
    [ -f "$apk" ] || fail 4 apk_missing "build succeeded but APK is missing at $apk" \
      "check Android Gradle output naming for $PROFILE"
    succeed "\"profile\":\"$PROFILE\",\"package_id\":\"$(package_id)\",\"gradle_task\":\"$task\",\"apk\":\"$(json_escape "$apk")\",\"bytes\":$(stat -c%s "$apk"),\"sha256\":\"$(sha256sum "$apk" | cut -d' ' -f1)\"" "built $apk"
    ;;
  install)
    [ "$#" -le 1 ] || fail 3 install_usage "usage: pm3 --serial SERIAL install [APK]" "provide zero or one APK path"
    need_serial
    apk="${1:-$(apk_path)}"
    [ -f "$apk" ] || fail 2 apk_unavailable "APK not built: $apk" \
      "run pm3 --profile $PROFILE build first"
    output="$(adb_s install -r "$apk" 2>&1)" || fail 4 install_failed \
      "install failed: $output" "check device storage, signing lineage, and install prompts"
    output="${output//$'\r'/}"
    install_result="$(printf '%s\n' "$output" | awk 'NF { line = $0 } END { print line }')"
    [ "$install_result" = Success ] || fail 4 install_failed "install failed: $output" \
      "check package signing lineage, device storage, and install prompts"
    package_dump="$(adb_s shell dumpsys package "$(package_id)" 2>&1)" || fail 4 package_query_failed \
      "installed package query failed: $package_dump" "verify the explicit serial remains connected"
    installed_version="$(printf '%s\n' "$package_dump" | grep -m1 versionName | sed 's/.*versionName=//' | tr -d '\r ')"
    [ -n "$installed_version" ] || fail 4 version_missing "installed package has no versionName" "verify the expected package was installed"
    device_path_output="$(adb_s shell pm path "$(package_id)" 2>&1)" || fail 4 package_path_failed \
      "installed package path query failed: $device_path_output" "verify the explicit serial remains connected"
    device_apk="$(printf '%s\n' "$device_path_output" | sed -n 's/^package://p' | tr -d '\r' | head -1)"
    [ -n "$device_apk" ] || fail 4 package_path_missing "installed package has no base APK path" "verify the expected package is installed for the current user"
    verify_dir="${JCODE_SCRATCH_DIR:-${TMPDIR:-/tmp}}"
    mkdir -p "$verify_dir"
    installed_copy="$verify_dir/pm3-installed-$(package_id)-$$.apk"
    if ! adb_s pull "$device_apk" "$installed_copy" >/dev/null 2>&1 || [ ! -s "$installed_copy" ]; then
      rm -f "$installed_copy"
      fail 4 installed_apk_pull_failed "could not read back the installed base APK" "verify package visibility and device connectivity"
    fi
    local_sha="$(sha256sum "$apk" | cut -d' ' -f1)"
    installed_sha="$(sha256sum "$installed_copy" | cut -d' ' -f1)"
    if [ "$local_sha" != "$installed_sha" ]; then
      rm -f "$installed_copy"
      fail 4 installed_apk_mismatch "installed APK hash differs from the selected local artifact" "uninstall only with approval if signer lineage blocks exact replacement, then reinstall the named APK"
    fi
    apksigner_cmd="$(selected_apksigner)"
    [ -x "$apksigner_cmd" ] || { rm -f "$installed_copy"; fail 2 dependency_unavailable \
      "apksigner unavailable at $apksigner_cmd" "run scripts/bootstrap-android.sh or set PM3_APKSIGNER"; }
    signer_output="$($apksigner_cmd verify --verbose --print-certs "$installed_copy" 2>&1)" || {
      rm -f "$installed_copy"
      fail 4 installed_signer_invalid "installed APK signer verification failed: $signer_output" "rebuild and reinstall the selected artifact"
    }
    signer_sha="$(printf '%s\n' "$signer_output" | awk -F': ' '/certificate SHA-256 digest:/{print tolower($2); exit}' | tr -d ':[:space:]')"
    rm -f "$installed_copy"
    [ -n "$signer_sha" ] || fail 4 installed_signer_missing "installed APK signer fingerprint is unavailable" "inspect the artifact with apksigner"
    succeed "\"serial\":\"$(json_escape "$SERIAL")\",\"package_id\":\"$(package_id)\",\"apk\":\"$(json_escape "$apk")\",\"installed_version\":\"$(json_escape "$installed_version")\",\"local_sha256\":\"$local_sha\",\"installed_sha256\":\"$installed_sha\",\"signer_sha256\":\"$signer_sha\"" "installed and verified $(package_id) on $SERIAL"
    ;;
  run)
    no_args "$@"
    need_serial
    package="$(package_id)"
    adb_s shell am start -n "$package/.MainActivity" >/dev/null 2>&1 || fail 4 launch_failed "am start failed" "run pm3 install first"
    pid_output="$(adb_s shell pidof "$package" 2>&1)" || fail 4 pid_query_failed \
      "pid query failed: $pid_output" "verify the explicit serial remains connected"
    pids="$(printf '%s' "$pid_output" | tr -d '\r' | xargs)"
    [ -n "$pids" ] || fail 4 process_missing "app did not stay up" "run pm3 --serial $SERIAL logcat"
    succeed "\"serial\":\"$(json_escape "$SERIAL")\",\"package_id\":\"$package\",\"pids\":\"$(json_escape "$pids")\"" "started $package on $SERIAL"
    ;;
  logcat)
    no_args "$@"
    need_serial
    package="$(package_id)"
    printf 'pm3 logcat: streaming adb logcat as NDJSON\n' >&2
    "$ADB_CMD" -s "$SERIAL" logcat -v time -s phosphor-mobil3:V AndroidRuntime:E DEBUG:F \
      2> >(sed 's/^/adb: /' >&2) |
      while IFS= read -r line; do
        stream_event logcat "\"serial\":\"$(json_escape "$SERIAL")\",\"package_id\":\"$package\",\"line\":\"$(json_escape "$line")\""
      done
    logcat_rc="${PIPESTATUS[0]}"
    [ "$logcat_rc" -eq 0 ] || stream_fail logcat_failed "adb logcat exited $logcat_rc" \
      "verify the explicit serial remains connected"
    ;;
  screenshot)
    [ "$#" -le 1 ] || fail 3 screenshot_usage "usage: pm3 screenshot [out.png]" "provide zero or one output path"
    need_serial
    output_path="${1:-$REPO/docs/dev/receipts/screen-$(date +%Y%m%d-%H%M%S).png}"
    mkdir -p "$(dirname "$output_path")"
    tmp_output="$(dirname "$output_path")/.pm3-$(basename "$output_path").$$.tmp"
    if ! "$ADB_CMD" -s "$SERIAL" exec-out screencap -p >"$tmp_output" 2>/dev/null || [ ! -s "$tmp_output" ]; then
      rm -f "$tmp_output"
      fail 4 screenshot_capture_failed "screencap produced no image" "ensure the explicit device is connected, on, and unlocked"
    fi
    mv -f "$tmp_output" "$output_path" || { rm -f "$tmp_output"; fail 4 screenshot_save_failed "screencap save failed" "verify the output directory is writable"; }
    succeed "\"png\":\"$(json_escape "$output_path")\",\"bytes\":$(stat -c%s "$output_path")" "saved $output_path"
    ;;
  record)
    [ "$#" -le 2 ] || fail 3 record_usage "usage: pm3 record [seconds] [out.mp4]" "provide a numeric duration and optional output path"
    seconds="${1:-10}"
    case "$seconds" in *[!0-9]*|'') fail 3 invalid_duration "record seconds must be numeric" "use pm3 record 10" ;; esac
    if [ "$seconds" -lt 1 ] || [ "$seconds" -gt 180 ]; then fail 3 invalid_duration "record seconds must be from 1 through 180" "use pm3 record 10"; fi
    need_serial
    output_path="${2:-$REPO/docs/dev/receipts/record-$(date +%Y%m%d-%H%M%S).mp4}"
    mkdir -p "$(dirname "$output_path")"
    tmp_output="$(dirname "$output_path")/.pm3-$(basename "$output_path").$$.tmp"
    screenrecord_detail="$(adb_s shell screenrecord --time-limit "$seconds" /sdcard/pm3-rec.mp4 2>&1)" || {
      adb_s shell rm /sdcard/pm3-rec.mp4 >/dev/null 2>&1 || true
      fail 4 record_capture_failed "screenrecord failed: $screenrecord_detail" "ensure the screen is on and device storage is available"
    }
    if ! adb_s pull /sdcard/pm3-rec.mp4 "$tmp_output" >/dev/null || [ ! -s "$tmp_output" ]; then
      rm -f "$tmp_output"
      adb_s shell rm /sdcard/pm3-rec.mp4 >/dev/null 2>&1 || true
      fail 4 record_pull_failed "screenrecord pull failed" "verify device storage and the explicit serial"
    fi
    if ! adb_s shell rm /sdcard/pm3-rec.mp4 >/dev/null; then
      rm -f "$tmp_output"
      fail 4 record_cleanup_failed "record pulled but device cleanup failed" "remove /sdcard/pm3-rec.mp4, then retry"
    fi
    mv -f "$tmp_output" "$output_path" || { rm -f "$tmp_output"; fail 4 record_save_failed "record save failed" "verify the output directory is writable"; }
    succeed "\"mp4\":\"$(json_escape "$output_path")\",\"bytes\":$(stat -c%s "$output_path"),\"seconds\":$seconds" "saved $output_path"
    ;;
  media)
    no_args "$@"
    need_serial
    package="$(package_id)"
    media_dump="$(adb_s shell dumpsys media_session 2>&1)" || fail 4 media_query_failed "media-session query failed: $media_dump" "verify the explicit serial remains connected"
    audio_dump="$(adb_s shell dumpsys audio 2>&1)" || fail 4 audio_query_failed "audio query failed: $audio_dump" "verify the explicit serial remains connected"
    media_session="$(printf '%s\n' "$media_dump" | grep -iA6 "$package" | head -20 || true)"
    audio="$(printf '%s\n' "$audio_dump" | grep -i "$package" | head -10 || true)"
    succeed "\"media_session\":\"$(json_escape "${media_session:-none}")\",\"audio\":\"$(json_escape "${audio:-none}")\"" "media_session=${media_session:-none}; audio=${audio:-none}"
    ;;
  fps)
    no_args "$@"
    need_serial
    gfx_dump="$(adb_s shell dumpsys gfxinfo "$(package_id)" 2>&1)" || fail 4 gfxinfo_query_failed "gfxinfo query failed: $gfx_dump" "verify the explicit serial remains connected"
    gfx="$(printf '%s\n' "$gfx_dump" | grep -E 'Total frames|Janky|percentile' | head -8 || true)"
    [ -n "$gfx" ] || fail 2 gfxinfo_unavailable "no gfxinfo for $(package_id)" "run pm3 run first and render a visible frame"
    succeed "\"gfxinfo\":\"$(json_escape "$gfx")\"" "$gfx"
    ;;
  smoke)
    no_args "$@"
    [ "$PROFILE" = debug ] || fail 2 debuggable_required "smoke requires the debug profile" "rerun with --profile debug"
    need_serial
    package="$(package_id)"
    package_dump="$(adb_s shell pm dump "$package" 2>&1)" || fail 4 package_query_failed "installed package query failed: $package_dump" "verify the explicit serial remains connected"
    printf '%s\n' "$package_dump" | grep -q 'pkgFlags.*DEBUGGABLE' || fail 2 debuggable_required "installed build is not debuggable" "build and install the debug profile"
    adb_s shell am broadcast -a "dev.phosphor.mobil3.SELFTEST" -n "$package/.SelfTestReceiver" >/dev/null 2>&1 || fail 4 broadcast_failed "broadcast failed" "install a current debug build"
    report=""
    for _ in $(seq 1 20); do
      sleep 0.5
      report="$(adb_s shell run-as "$package" cat files/selftest.json 2>/dev/null)"
      [ -n "$report" ] && break
    done
    [ -n "$report" ] || fail 4 selftest_timeout "selftest.json never appeared" "run pm3 --serial $SERIAL logcat"
    output_path="$RECEIPTS_DIR/selftest-$(date +%Y%m%d-%H%M%S).png"
    mkdir -p "$(dirname "$output_path")"
    if ! "$ADB_CMD" -s "$SERIAL" shell run-as "$package" cat files/selftest.png >"$output_path" 2>/dev/null || [ ! -s "$output_path" ]; then
      rm -f "$output_path"
      fail 4 selftest_image_failed "selftest image pull failed" "inspect pm3 logcat on the explicit device"
    fi
    succeed "\"report_json\":\"$(json_escape "$report")\",\"png_pulled\":\"$(json_escape "$output_path")\"" "selftest passed; image=$output_path"
    ;;
  *) fail 3 unknown_verb "unknown verb: $VERB" "run pm3 help or pm3 schema" ;;
esac
